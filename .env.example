# Copy to .env (never commit .env). On Linux: chmod 600 .env
#
# Shared secret between the api and opa containers (>= 32 chars). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OPA_AUTH_TOKEN=

# Host interface Caddy listens on. Use the OMEN's LAN IP to avoid exposing the
# service on other interfaces (e.g. VPN / Hyper-V adapters).
OPM_BIND_ADDRESS=192.168.7.7
OPM_HTTPS_PORT=443

# Certificate name used when clients connect by IP (no SNI). Must be a SAN
# in deploy/certs/server.crt.
OPM_TLS_SERVER_NAME=opm.lan

# UID/GID Caddy runs as; must be able to read deploy/certs/server.key.
# Linux: `id -u` / `id -g` of the deploy user. Docker Desktop: leave 1000.
OPM_UID=1000
OPM_GID=1000

# Limits / performance (defaults shown)
OPM_MAX_BODY_SIZE=5MB
OPM_MAX_BODY_BYTES=5242880
OPM_MAX_RECORDS_PER_EVALUATION=10000
OPM_MAX_BATCH_ITEMS=100
OPM_MAX_BATCH_TOTAL_RECORDS=50000
OPM_BATCH_CONCURRENCY=8
OPM_EVALUATION_TIMEOUT_SECONDS=30
OPM_RATE_LIMIT_PER_MINUTE=600
OPM_RATE_LIMIT_BURST=100
OPM_HISTORICAL_THRESHOLD_DAYS=35
OPM_LOG_LEVEL=INFO

# Regulatory catalog / published bundles (see docs/REGINTEL.md)
# Host directory OPA and the API load as the policy bundle. Leave unset for the
# base bundle; set to an activated immutable version after `regintel bundle-activate`.
# OPM_BUNDLE_HOST_DIR=./bundle-store/versions/<version>

# Local regulatory extraction worker. Both `python -m regintel` and the native
# launcher read .env; exported environment variables take precedence.
# Install/pull this model first: ollama pull gemma3:4b
OPM_REGINTEL_LLM_URL=http://127.0.0.1:11434
OPM_REGINTEL_LLM_MODEL=gemma3:4b
OPM_REGINTEL_REQUIRE_GPU=1
OPM_REGINTEL_LLM_NUM_CTX=4096
OPM_REGINTEL_LLM_NUM_PREDICT=2048
OPM_REGINTEL_LLM_TIMEOUT=600
OPM_REGINTEL_LLM_KEEP_ALIVE=5m
# Bound automated catalog jobs (unset = every language and every section; very slow on small GPUs)
OPM_REGINTEL_AUTOMATION_LANGUAGES=en
OPM_REGINTEL_AUTOMATION_SCREENING=pam-keyword-screen-v1
# Bounded automatic rule generation (DJANGO_CONTRACT.md §5.4). Both off by default; jobs must also opt in.
REGINTEL_AUTO_RULE_GENERATION=false
REGINTEL_AUTO_PUBLISH_GENERATED_RULES=false
# OPM_REGINTEL_RULE_GENERATION_MIN_CONFIDENCE=0.8
# Rules whose evidence the PAM (Django) bridge collects; automation maps requirements to these only.
# Extend only after the collector schema is agreed with the Django side.
# OPM_REGINTEL_BRIDGE_COLLECTED_RULES=PAM-ROTATION-001,PAM-DORMANT-001,PAM-SESSREC-001

# Optional native host-side catalog management (run_native.py --with-catalog-admin).
# These paths are writable only by the management process; the evaluator stays read-only.
# OPM_CATALOG_UPLOAD_DIR=data/regintel/uploads
# OPM_CATALOG_JOBS_DB_PATH=data/regintel/jobs.db
