{
  "$defs": {
    "LeafGroup": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "enum": [
            "all",
            "any",
            "none"
          ],
          "title": "Operator",
          "type": "string"
        },
        "where": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Where",
          "type": "array"
        }
      },
      "required": [
        "operator",
        "where"
      ],
      "title": "LeafGroup",
      "type": "object"
    },
    "ParameterDecl": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "default": "none",
          "enum": [
            "days",
            "hours",
            "minutes",
            "seconds",
            "attempts",
            "count",
            "none"
          ],
          "title": "Unit",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 300,
          "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
          "title": "Description",
          "type": "string"
        },
        "policy_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Organization setting that may supply the value when the text states none."
        },
        "minimum": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        }
      },
      "required": [
        "type"
      ],
      "title": "ParameterDecl",
      "type": "object"
    },
    "PolicyBinding": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "^PC-[A-Z0-9-]{2,40}$",
          "title": "Control Id",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "parameter"
      ],
      "title": "PolicyBinding",
      "type": "object"
    },
    "Population": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ORGANIZATION_SUPPORTED_ENTITIES",
          "title": "Type",
          "type": "string"
        },
        "period_field": {
          "description": "Non-null datetime field; only records inside the period count.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Period Field",
          "type": "string"
        },
        "where": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "maxItems": 10,
          "title": "Where",
          "type": "array"
        }
      },
      "required": [
        "type",
        "period_field"
      ],
      "title": "Population",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal",
            "in",
            "not_in",
            "contains",
            "exists",
            "not_exists",
            "older_than_days",
            "within_last_days"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "maxLength": 64,
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only for boolean/enum/tag literals.",
          "title": "Value"
        },
        "parameter": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of a declared parameter (every threshold).",
          "title": "Parameter"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "RootGroup": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "enum": [
            "all",
            "any",
            "none"
          ],
          "title": "Operator",
          "type": "string"
        },
        "where": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Predicate"
              },
              {
                "$ref": "#/$defs/LeafGroup"
              }
            ]
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Where",
          "type": "array"
        }
      },
      "required": [
        "operator",
        "where"
      ],
      "title": "RootGroup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "1.0",
      "title": "Spec Version",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 3,
      "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
      "title": "Description",
      "type": "string"
    },
    "pam_control_id": {
      "pattern": "^PAMC-[A-Z0-9-]{2,40}$",
      "title": "Pam Control Id",
      "type": "string"
    },
    "evidence_type": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Evidence Type",
      "type": "string"
    },
    "evidence_schema_version": {
      "pattern": "^\\d{1,3}\\.\\d{1,3}$",
      "title": "Evidence Schema Version",
      "type": "string"
    },
    "assessment_mode": {
      "enum": [
        "EVENT_HISTORY",
        "CONFIGURATION_SNAPSHOT"
      ],
      "title": "Assessment Mode",
      "type": "string"
    },
    "subject_field": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Subject Field",
      "type": "string"
    },
    "population": {
      "$ref": "#/$defs/Population"
    },
    "parameters": {
      "maxProperties": 6,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/ParameterDecl"
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Predicate"
        },
        {
          "$ref": "#/$defs/RootGroup"
        }
      ],
      "description": "What every in-population record must satisfy.",
      "title": "Condition"
    },
    "missing_evidence_result": {
      "const": "INSUFFICIENT_EVIDENCE",
      "title": "Missing Evidence Result",
      "type": "string"
    },
    "coverage": {
      "const": "PARTIAL",
      "default": "PARTIAL",
      "title": "Coverage",
      "type": "string"
    },
    "source_requirement_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Source Requirement Ids",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 500,
        "minLength": 10,
        "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "spec_version",
    "title",
    "pam_control_id",
    "evidence_type",
    "evidence_schema_version",
    "assessment_mode",
    "subject_field",
    "population",
    "condition",
    "missing_evidence_result",
    "source_requirement_ids",
    "limitations"
  ],
  "title": "RuleSpec",
  "type": "object",
  "$comment": "RuleSpec 1.0: the only rule content an LLM may propose. Validated, resolved, compiled (pam-rulespec-compiler-1.0) and tested by OPM; never executed as code."
}
