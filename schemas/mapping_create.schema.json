        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Version Min"
    },
    "rule_version_max": {
      "anyOf": [
        {
          "pattern": "^\\d{1,3}\\.\\d{1,3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Version Max"
    },
    "evidence_type": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
