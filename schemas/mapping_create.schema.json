    "limitations": {
      "maxLength": 4000,
      "minLength": 10,
      "title": "Limitations",
      "type": "string"
    },
    "pam_control_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pam Control Id"
    },
    "control_reference": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Reference"
    },
    "rule_id": {
