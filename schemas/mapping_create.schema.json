        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Id"
    },
    "rule_version_min": {
      "anyOf": [
        {
          "pattern": "^\\d{1,3}\\.\\d{1,3}$",
          "type": "string"
