{
  "$comment": "Semantic allowlist for customer rules. Only these fields and operators are accepted.",
  "max_total_conditions": 25,
  "max_nesting": "root group -> leaf groups (2 levels)",
  "operators_by_field_type": {
    "string": [
      "eq",
      "in",
      "is_null",
      "ne",
      "not_in",
      "not_null"
    ],
    "enum": [
      "eq",
      "in",
      "is_null",
      "ne",
      "not_in",
      "not_null"
    ],
    "boolean": [
      "eq",
      "ne"
    ],
    "integer": [
      "eq",
      "gt",
      "gte",
      "in",
      "lt",
      "lte",
      "ne",
      "not_in"
    ],
    "datetime": [
      "gt",
      "gte",
      "is_null",
      "lt",
      "lte",
      "not_null",
      "older_than_days",
      "within_last_days"
    ],
    "string_list": [
      "contains"
    ]
  },
  "null_operators_require_nullable_field": [
    "is_null",
    "not_null"
  ],
