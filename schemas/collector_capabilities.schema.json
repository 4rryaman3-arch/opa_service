{
  "$defs": {
    "CollectorInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "CollectorInfo",
      "type": "object"
    },
    "EvidenceSupport": {
      "additionalProperties": false,
      "properties": {
        "evidence_type": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Evidence Type",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^\\d{1,3}\\.\\d{1,3}$",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_modes": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "EVENT_HISTORY",
                  "CONFIGURATION_SNAPSHOT"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Modes"
        },
        "supported_fields": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supported Fields"
        },
        "collection_status": {
          "default": "COLLECTED",
          "enum": [
            "COLLECTED",
            "LOOKUP_AVAILABLE"
          ],
          "title": "Collection Status",
          "type": "string"
        },
        "source_models": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z0-9_.]{1,100}$",
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Models"
        },
        "caveats": {
          "anyOf": [
            {
              "items": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caveats"
        },
        "field_meanings": {
          "anyOf": [
            {
              "maxProperties": 64,
              "patternProperties": {
                "^[a-z][a-z0-9_]{0,63}$": {
                  "additionalProperties": {
                    "maxLength": 300,
                    "minLength": 1,
                    "type": "string"
                  },
                  "propertyNames": {
                    "enum": [
                      "meaning",
                      "shows"
                    ]
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Meanings"
        }
      },
      "required": [
        "evidence_type",
        "schema_version"
      ],
      "title": "EvidenceSupport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "anyOf": [
        {
          "const": "1.0",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Version"
    },
    "tenant_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "collector": {
      "$ref": "#/$defs/CollectorInfo"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceSupport"
      },
      "maxItems": 100,
      "title": "Evidence",
      "type": "array"
    },
    "settings_sources": {
      "anyOf": [
        {
          "maxProperties": 50,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "maxLength": 200,
              "type": "string"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Settings Sources"
    }
  },
  "required": [
    "tenant_id",
    "collector",
    "evidence"
  ],
  "title": "CollectorCapabilitiesIn",
  "type": "object"
}
