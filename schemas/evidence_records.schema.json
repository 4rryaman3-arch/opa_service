    "credential_rotation": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "scope_tags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Scope Tags",
          "type": "array"
        },
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "privileged": {
          "title": "Privileged",
          "type": "boolean"
        },
        "last_rotated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Rotated At"
        },
        "last_rotation_status": {
          "anyOf": [
            {
              "enum": [
                "SUCCESS",
                "FAILED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Rotation Status"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "breached": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breached"
        },
        "policy_compliant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Compliant"
        }
      },
      "required": [
        "record_id",
        "account_id",
        "privileged",
        "last_rotated_at"
      ],
      "title": "CredentialRotationRecord",
      "type": "object"
