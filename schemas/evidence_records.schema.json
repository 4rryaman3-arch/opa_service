    "mfa_configuration": {
      "additionalProperties": false,
      "description": "Configuration snapshot: whether MFA is enforced for a principal at ``captured_at``.\nIt says nothing about whether MFA was actually performed at each access.",
      "properties": {
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "scope_tags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
