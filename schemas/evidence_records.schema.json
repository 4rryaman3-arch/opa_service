{
  "$comment": "One schema per evidence_type; records are validated against the schema of the request's evidence_type.",
  "evidence_schema_versions": {
    "credential_rotation": "1.0",
    "privileged_session": "1.0",
    "privileged_access_request": "1.0",
    "privileged_account": "1.0",
    "authentication_summary": "1.0",
    "access_authorization": "1.0",
    "break_glass_event": "1.0",
    "policy_exception": "1.0",
    "access_review": "1.0",
    "audit_log_coverage": "1.0",
    "mfa_configuration": "1.0",
    "privileged_access_authentication": "1.0",
    "session_policy_configuration": "1.0"
  },
  "evidence_types": {
    "credential_rotation": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "scope_tags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Scope Tags",
          "type": "array"
        },
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "privileged": {
          "title": "Privileged",
          "type": "boolean"
        },
        "last_rotated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Rotated At"
        },
        "last_rotation_status": {
          "anyOf": [
            {
              "enum": [
                "SUCCESS",
                "FAILED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Rotation Status"
        }
      },
      "required": [
        "record_id",
        "account_id",
        "privileged",
        "last_rotated_at"
      ],
      "title": "CredentialRotationRecord",
      "type": "object"
    },
