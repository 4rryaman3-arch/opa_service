        "principal_type": {
          "enum": [
            "USER",
            "ACCOUNT"
          ],
          "title": "Principal Type",
          "type": "string"
        },
        "privileged": {
          "title": "Privileged",
          "type": "boolean"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "mfa_enforced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mfa Enforced"
        },
        "mfa_methods": {
          "items": {
            "enum": [
              "totp",
              "push",
              "fido2",
              "smart_card",
              "hardware_token",
              "sms",
              "email_otp"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Mfa Methods",
          "type": "array"
        },
