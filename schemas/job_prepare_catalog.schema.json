{
  "additionalProperties": false,
  "description": "Django rewrite contract 1.0: one-shot automated preparation. 'discovery'\nruns the automated pipeline over every approved framework registered for the\nrequested jurisdictions (OPM's own authority/source registry - never the\nopen internet). 'import' processes previously uploaded, organization-scoped\ndocuments, identifying their framework first. Requires catalog:automate and\nthe X-Securden-Organization-Scope header.",
  "properties": {
    "action": {
      "const": "prepare_catalog",
      "title": "Action",
      "type": "string"
    },
    "mode": {
      "enum": [
        "discovery",
        "import"
      ],
      "title": "Mode",
      "type": "string"
    },
    "jurisdictions": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Jurisdictions",
      "type": "array"
    },
    "industry": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Industry"
    },
    "requested_framework_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Requested Framework Ids",
      "type": "array"
    },
    "include_inherited": {
      "default": true,
      "title": "Include Inherited",
      "type": "boolean"
    },
    "document_ids": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "maxItems": 100,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Ids"
    },
    "tenant_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Id"
    },
    "llm_mapping": {
      "default": true,
      "title": "Llm Mapping",
      "type": "boolean"
    },
    "auto_rule_generation": {
      "default": false,
      "title": "Auto Rule Generation",
      "type": "boolean"
    },
    "auto_publish_validated_rules": {
      "default": false,
      "title": "Auto Publish Validated Rules",
      "type": "boolean"
    },
    "collector_capability_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collector Capability Digest"
    },
    "translate": {
      "default": true,
      "title": "Translate",
      "type": "boolean"
    },
    "as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "languages": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[a-z]{2,3}$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Languages"
    },
    "screening": {
      "anyOf": [
        {
          "enum": [
            "none",
            "pam-keyword-screen-v1"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Screening"
    },
    "request_key": {
      "maxLength": 100,
      "minLength": 8,
      "title": "Request Key",
      "type": "string"
    }
  },
  "required": [
    "action",
    "mode",
    "jurisdictions",
    "request_key"
  ],
  "title": "PrepareCatalog",
  "type": "object"
}
